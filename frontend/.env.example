# Spring API 주소. 프론트엔드 /api/* 요청이 이 주소로 전달됩니다.
BACKEND_URL=http://localhost:8082

# Google AdSense. 게시자 ID를 넣으면 피드·사이드·본문 광고가 켜지고, 비워 두면 개발 중에는 자리 표시만 보입니다.
NEXT_PUBLIC_ADSENSE_CLIENT=
# AdSense에서 만든 광고 단위 ID (숫자). 비워 두면 자동 광고 형식으로 요청합니다.
NEXT_PUBLIC_ADSENSE_SLOT_FEED=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
# 인피드(네이티브) 광고 단위의 레이아웃 키. 설정하면 피드 광고가 글 목록 줄처럼 보입니다.
NEXT_PUBLIC_ADSENSE_FEED_LAYOUT_KEY=
