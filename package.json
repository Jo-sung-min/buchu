{
  "name": "buchu",
  "version": "0.1.0",
  "private": true,
  "description": "나에게 맞는 부업을 찾는 정보 서비스, 부추",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "typecheck": "npm run typecheck --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "dev:backend": "node scripts/backend.mjs bootRun",
    "test:backend": "node scripts/backend.mjs test",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:status": "node scripts/local-db.mjs status"
  }
}
