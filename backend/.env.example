# PostgreSQL. Flyway applies migrations automatically at startup.
DB_URL=jdbc:postgresql://localhost:5433/buchu
DB_USERNAME=buchu
DB_PASSWORD=replace-with-your-local-database-password
PORT=8082

# Set a strong password before signing in at /admin. No default admin password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_COOKIE_SECURE=false

# local is the development implementation of the presigned upload contract.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# Set these when connecting S3. Prefer an IAM role in deployed environments.
STORAGE_BUCKET=
STORAGE_REGION=ap-northeast-2
STORAGE_ENDPOINT=
STORAGE_PATH_STYLE=false
CDN_BASE_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Course purchases are disabled until both Toss keys and the switch are configured.
# Start with matching test keys; never put TOSS_SECRET_KEY in frontend environment variables.
COURSE_PAYMENTS_ENABLED=false
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# Toss dashboard webhook: https://your-domain/api/payments/webhook
# Subscribe to PAYMENT_STATUS_CHANGED. Payload statuses are never trusted: the server
# re-queries Toss using TOSS_SECRET_KEY before accepting a full cancellation.
# Keep TOSS_SECRET_KEY configured when disabling new sales: existing course access
# and refund reconciliation still require payment-provider verification.
# Partial refunds and virtual-account deposits are not supported in this release.
